# Copy to .env (never commit real values). Set a domain with DNS pointing to your server.
TOKIHA_DOMAIN=photos.example.com
# Generate independent values: python3 -c 'import secrets; print(secrets.token_hex(32))'
TOKIHA_PASSWORD=replace-with-a-random-password-of-at-least-16-characters
TOKIHA_BACKUP_TOKEN=replace-with-another-random-token
